@model ReflectionIT.Mvc.Paging.PagingList<Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-orange">📦 Pedidos Realizados</h2>

        <div class="d-flex gap-3">
            <form method="post" class="d-flex gap-2">
                <input name="filter"
                       class="form-control bg-dark text-light border-orange"
                       style="min-width: 220px;"
                       placeholder="Filtrar pedidos..."
                       value="@Model.RouteValue["Filter"]" />

                <button type="submit" class="btn btn-orange">
                    🔍 Buscar
                </button>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead class="table-header">
                <tr>
                    <th>Nome</th>
                    <th>Sobrenome</th>
                    <th>Endereço</th>
                    <th>CEP</th>
                    <th>Estado</th>
                    <th>Cidade</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Enviado?</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-light">@item.Nome</td>
                        <td class="text-light">@item.Sobrenome</td>
                        <td class="text-muted">@item.Endereco1 @item.Endereco2</td>
                        <td class="text-light">@item.Cep</td>
                        <td class="text-light">@item.Estado</td>
                        <td class="text-light">@item.Cidade</td>
                        <td class="text-light">@item.Telefone</td>
                        <td class="text-light">@item.Email</td>

                        <td class="text-light">
                            @(string.IsNullOrEmpty(item.PedidoEnviado.ToString())
                                ? "—"
                                : "📤 Sim")
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">

                                <a asp-action="Edit"
                               asp-route-id="@item.PedidoId"
                               class="btn btn-outline-orange btn-sm">
                                    ✏️
                                </a>

                                <a asp-action="PedidoLanches"
                               asp-route-id="@item.PedidoId"
                               class="btn btn-outline-light btn-sm">
                                    🔍
                                </a>

                                <a asp-action="Delete"
                               asp-route-id="@item.PedidoId"
                               class="btn btn-outline-danger btn-sm">
                                    🗑
                                </a>

                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

        <div class="text-light mt-2">
            Total de pedidos: <span class="text-orange fw-bold">@Model.TotalRecordCount</span>
        </div>

        <div class="mt-3">
            <vc:pager paging-list="@Model" class="pagination-dark"></vc:pager>
        </div>

    </div>

</div>

<style>
    .pagination .page-link {
        background-color: #222 !important;
        color: #ff8800 !important;
        border: 1px solid #333 !important;
    }

    .pagination .page-item.active .page-link {
        background-color: #ff8800 !important;
        color: #000 !important;
        border-color: #ff8800 !important;
    }
</style>