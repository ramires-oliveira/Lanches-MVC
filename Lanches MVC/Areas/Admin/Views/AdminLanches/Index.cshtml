@model ReflectionIT.Mvc.Paging.PagingList<Lanche>

@{
    ViewData["Title"] = "Lanches";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-orange">🍔 Lanches Cadastrados</h2>

        <div class="d-flex gap-3">
            <form method="post" class="d-flex gap-2">
                <input name="filter" 
                       class="form-control bg-dark text-light border-orange"
                       style="min-width: 220px;"
                       placeholder="Filtrar produtos..." value="@Model.RouteValue["Filter"]" />
                <button type="submit" class="btn btn-orange">
                    🔍 Buscar
                </button>
            </form>

            <a asp-area="Admin"
               asp-controller="AdminLanches"
               asp-action="Create"
               class="btn btn-orange btn-lg">
                ➕ Novo Lanche
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead class="table-header">
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Preço</th>
                    <th>Imagem</th>
                    <th>Preferido</th>
                    <th>Estoque</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-light">@item.Nome</td>
                        <td class="text-muted">@item.DescricaoCurta</td>
                        <td class="text-light">R$ @item.Preco.ToString("N2")</td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagemUrl))
                            {
                                <img src="@item.ImagemUrl"
                             style="width:60px; border-radius:6px" />
                            }
                            else
                            {
                                <span class="text-muted">Sem imagem</span>
                            }
                        </td>

                        <td class="text-light">
                            @(item.IsLanchePreferido ? "✔️" : "—")
                        </td>

                        <td class="text-light">
                            @(item.EmEstoque ? "✔️" : "—")
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">

                                <a asp-area="Admin"
                               asp-controller="AdminLanches"
                               asp-action="Edit"
                               asp-route-id="@item.LancheId"
                               class="btn btn-outline-orange btn-sm">
                                    ✏️
                                </a>

                                <a asp-area="Admin"
                               asp-controller="AdminLanches"
                               asp-action="Details"
                               asp-route-id="@item.LancheId"
                               class="btn btn-outline-light btn-sm">
                                    🔍
                                </a>

                                <a asp-area="Admin"
                               asp-controller="AdminLanches"
                               asp-action="Delete"
                               asp-route-id="@item.LancheId"
                               class="btn btn-outline-danger btn-sm">
                                    🗑
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <span>Total de lanches: @Model.TotalRecordCount</span>

        <div id="lanches-pagination" class="mt-3">
            <vc:pager paging-list="@Model"></vc:pager>
        </div>
    </div>

</div>
<style>
    #lanches-pagination .pagination .page-link {
        background-color: #222 !important;
        color: #ff8800 !important;
        border: 1px solid #333 !important;
    }

    #lanches-pagination .pagination .page-item.active .page-link {
        background-color: #ff8800 !important;
        color: #000 !important;
        border-color: #ff8800 !important;
    }
</style>
